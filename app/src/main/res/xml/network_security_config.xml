<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!--
      Allow plain HTTP only in debug builds, for talking to the local dev API
      (emulator's 10.0.2.2 host alias, or a teammate's own LAN IP set via
      API_BASE_URL in local.properties). Release builds stay HTTPS-only.
    -->
    <debug-overrides>
        <base-config cleartextTrafficPermitted="true" />
    </debug-overrides>
</network-security-config>
