# Dependencies
node_modules/

# Secrets / local config  -- NEVER commit these
.env
.env.*
!.env.example
# Firebase service-account keys (if you use a file instead of FIREBASE_SERVICE_ACCOUNT)
serviceAccountKey.json
*-firebase-adminsdk-*.json
google-services.json

# Build output
dist/
build/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS / editor junk
.DS_Store
Thumbs.db
*.swp

# Optional: keep shared VS Code settings, ignore per-user ones
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
