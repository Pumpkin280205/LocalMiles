# Copy to .env and fill in real values. Do NOT commit .env.
PORT=3000
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
JWT_SECRET=

# SSO verifiers for POST /api/auth/login. Set at least one.
# - GOOGLE_CLIENT_ID: verifies raw Google Sign-In ID tokens.
# - FIREBASE_SERVICE_ACCOUNT: the Firebase service-account JSON on ONE line;
#   verifies Firebase Auth ID tokens. If both are set, Firebase is tried first
#   and Google is the fallback.
GOOGLE_CLIENT_ID=
FIREBASE_SERVICE_ACCOUNT=
